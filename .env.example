# LiveKit local dev server started with: livekit-server --dev
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Read by the local Python voice agent, never exposed to the browser.
GROQ_API_KEY=

# Indic TTS provider (e.g. Sarvam Bulbul for hi/te/ta/ml/kn/en)
SARVAM_API_KEY=

